<Window x:Class="MacConnectViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacConnect"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Grid>
        <!-- The picture and the arrow share this box, so a click lands on the pixel the arrow is touching. -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Picture" Width="1440" Height="900" Background="Black">
                <Image x:Name="FrameImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="Linear"
                       MouseMove="OnMouseMove"
                       MouseDown="OnMouseDown"
                       MouseUp="OnMouseUp"
                       MouseWheel="OnMouseWheel"
                       MouseLeave="OnMouseLeave"/>
                <Canvas IsHitTestVisible="False">
                    <Polygon x:Name="MacCursor"
                             Visibility="Collapsed"
                             Points="0,0 0,17 4.5,13 7.5,20 10,19 7,12 12.5,12"
                             Fill="Black"
                             Stroke="White"
                             StrokeThickness="1"
                             StrokeLineJoin="Round"
                             SnapsToDevicePixels="True"/>
                </Canvas>
            </Grid>
        </Viewbox>
        <StackPanel x:Name="WaitingPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock Text="Waiting for Mac…"
                       FontSize="32"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Press Esc to use this Windows PC."
                       Margin="0,12,0,0"
                       FontSize="16"
                       Foreground="#FFB0B0B0"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="AddressText"
                       Margin="0,24,0,0"
                       FontSize="16"
                       Foreground="#FF80B0FF"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
